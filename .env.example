# Frontend env vars for Vercel deployment.
# Prefix with VITE_ so Vite can expose them to browser code.

# Supabase client credentials
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_publishable_or_anon_key"

# Server-side Supabase credentials used by Face ID and Gemini team import.
# Keep these server-only: never prefix them with VITE_.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_secret_or_service_role_key"

# Server-side key for Vercel Function proxying TBA requests
TBA_API_KEY="your_tba_api_key"

# Server-side key for Vercel Function Gemini analysis
GEMINI_API_KEY="your_gemini_api_key"
